# SBI PO PRELIMINARY MOCK CBT PLATFORM - PRODUCTION ENVIRONMENT CONFIGURATION

# Base Application URL
NEXT_PUBLIC_APP_URL=https://mockcbt.example.com

# Supabase Production Database & RLS Credentials
# (Provide live Supabase project URL and Anon key when deploying to live server)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Storage & Ingestion Mode Configuration
# Local Workspace Path (Used in local development: /source-files/pdfs)
LOCAL_PDF_SOURCE_PATH=source-files/pdfs
# Fallback Mode for Serverless Platforms (Vercel/Netlify): 'upload_only' or 'local_scan'
INGESTION_STORAGE_MODE=auto

# Security & Secret Keys
JWT_SECRET=your-secure-jwt-secret-key-min-32-chars
